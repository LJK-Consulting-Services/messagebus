#!/usr/bin/env python3
"""Run one swarm member: sleep on the bus, wake a seat (claude, codex, omp, agy) when a post addresses it.

Usage: swarm-worker <agent-id> <harness> [--model M] [--effort E] [--workspace DIR]

The member must already have joined the room (swarm-spawn does `bus join --replay`); the worker never re-joins,
so a brief posted before it started is still delivered. Each wake:
  state=working (heartbeat keeps presence alive) -> run the seat with the new posts on stdin ->
  record tokens/cost -> state=waiting.
Claude, codex and omp seats resume one session across wakes and reply with `bus send` themselves. agy and
any SWARM_SEAT_REPLY=stdout seat cannot run tools, so the worker posts its output for it.

Seats come from the swarm config (scripts/swarm_config.py, examples/swarm.yaml).
Env: BUS_URL, BUS_ROOM, BUS_DIR, BUS_WAIT_SECS, SWARM_COORDINATOR (default coordinator),
SWARM_HEARTBEAT_SECS (default 30), SWARM_CLAUDE_FLAGS, SWARM_SEAT_CMD (seat `cmd` without a command).
Exit: 0 on __SHUTDOWN__ or stop file, 3 when a worker with this id is already running.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import shlex
import subprocess
import sys
import threading
import time

import swarm_config

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir))
BUS_PATH = os.environ.get("BUS_BIN", os.path.join(ROOT, "bus"))
PROMPT_PATH = os.path.join(ROOT, "prompts", "swarm-worker.md")
RESUME_FAILED = ("no conversation found", "session not found", "could not resume", "no session")


def load_bus():
    loader = importlib.machinery.SourceFileLoader("bus_cli", BUS_PATH)
    spec = importlib.util.spec_from_loader("bus_cli", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


bus = load_bus()


class Worker:
    def __init__(self, args, cfg):
        self.agent, self.harness = args.agent, args.harness
        self.seat = swarm_config.seat(cfg, args.harness)
        self.claude_flags = cfg["claude_flags"]
        self.model, self.effort, self.workspace = args.model, args.effort, args.workspace
        self.room = os.environ.get("BUS_ROOM", bus.DEFAULT_ROOM)
        self.r = bus.connect(os.environ.get("BUS_URL", bus.DEFAULT_URL))
        self.state_dir = os.path.join(os.environ.get("BUS_DIR", os.path.join(ROOT, ".bus-state")), self.room)
        self.coordinator = os.environ.get("SWARM_COORDINATOR", "coordinator")
        self.wait_secs = float(os.environ.get("BUS_WAIT_SECS", "60"))
        self.heartbeat_secs = float(os.environ.get("SWARM_HEARTBEAT_SECS", "30"))
        self.seat_timeout = float(os.environ.get("SWARM_SEAT_TIMEOUT", "3600"))
        os.makedirs(self.state_dir, exist_ok=True)

    # ---- files: pid lock, session id, stop sentinels -------------------------
    def path(self, name):
        return os.path.join(self.state_dir, f"{self.agent}.{name}")

    def lock(self):
        pid_file = self.path("pid")
        try:
            other = int(open(pid_file).read().strip())
            os.kill(other, 0)
            sys.stderr.write(f"swarm-worker: {self.agent} already running as pid {other}\n")
            sys.exit(3)
        except (FileNotFoundError, ValueError, ProcessLookupError):
            pass
        with open(pid_file, "w") as f:
            f.write(str(os.getpid()))

    def unlock(self):
        try:
            os.remove(self.path("pid"))
        except FileNotFoundError:
            pass

    def session(self):
        try:
            return open(self.path("session")).read().strip()
        except FileNotFoundError:
            return ""

    def save_session(self, sid):
        if sid:
            with open(self.path("session"), "w") as f:
                f.write(sid)

    def drop_session(self):
        try:
            os.remove(self.path("session"))
        except FileNotFoundError:
            pass

    def should_stop(self):
        return any(os.path.exists(os.path.join(self.state_dir, n)) for n in ("stop-all", f"stop-{self.agent}"))

    # ---- bus ------------------------------------------------------------------
    def set_state(self, state, doing=None):
        fields = {"state": state, "state_at": bus.now_iso()}
        if doing:
            fields["doing"] = doing
        self.r.hset(bus.k_member(self.room, self.agent), mapping=fields)
        bus.touch_presence(self.r, self.room, self.agent)

    def wait(self):
        """(posts for this member, the cursor to commit once they are handled). Posts not for the member are
        skipped at once; posts for it are committed only after the wake, so a worker killed mid-wake gets them
        again when it is respawned."""
        deadline = time.monotonic() + self.wait_secs
        while time.monotonic() < deadline:
            bus.touch_presence(self.r, self.room, self.agent)
            delivered, last_seen = bus.read_from_cursor(self.r, self.room, self.agent, block_ms=bus.BLOCK_CHUNK_MS)
            if delivered:
                return delivered, last_seen
            if last_seen:
                self.commit(last_seen)
        return [], None

    def commit(self, cursor):
        self.r.set(bus.k_cursor(self.room, self.agent), cursor)

    def post(self, to, body, kind="msg"):
        self.r.xadd(bus.k_stream(self.room), bus.make_fields(self.agent, to, body, kind=kind))

    def record_usage(self, usage):
        key = bus.k_member(self.room, self.agent)
        self.r.hincrby(key, "tokens_in", usage["in"])
        self.r.hincrby(key, "tokens_out", usage["out"])
        self.r.hincrby(key, "turns", 1)
        if usage["cost"] is not None:
            self.r.hincrbyfloat(key, "cost_usd", usage["cost"])

    # ---- one wake -------------------------------------------------------------
    def heartbeat(self, done):
        while not done.wait(self.heartbeat_secs):
            bus.touch_presence(self.r, self.room, self.agent)

    def run_seat(self, prompt):
        sid = self.session()
        result = self.invoke(prompt, sid)
        if result.returncode and sid and resume_failed(result.stderr):
            self.drop_session()
            note = "Your previous session could not be resumed. Run `bus history` to catch up.\n\n"
            result = self.invoke(note + prompt, "")
        return result

    def invoke(self, prompt, sid):
        argv, stdin, env = SEATS[self.seat["kind"]](self, prompt, sid)
        try:
            return subprocess.run(argv, input=stdin, capture_output=True, text=True, env=env, cwd=self.workspace,
                                  timeout=self.seat_timeout)
        except subprocess.TimeoutExpired:
            return failed(argv, 124, f"seat timed out after {self.seat_timeout:.0f}s (SWARM_SEAT_TIMEOUT)")
        except OSError as e:
            return failed(argv, 127, f"could not start the seat: {type(e).__name__}: {e}")

    def wake(self, msgs):
        self.set_state("working")
        head = self.stream_head()
        stop = threading.Event()
        threading.Thread(target=self.heartbeat, args=(stop,), daemon=True).start()
        try:
            result = self.run_seat(self.render(msgs))
        finally:
            stop.set()
        parsed = parse_output(result.stdout)
        self.save_session(parsed["session"] or self.session_after_first_wake())
        self.record_usage(parsed)
        if result.returncode:
            self.report_crash(result)
        elif self.replies_on_stdout() or not self.posted_since(head):
            self.post(senders(msgs), parsed["text"] or result.stdout.strip() or "(no output)")
        self.set_state("waiting")

    def stream_head(self):
        last = self.r.xrevrange(bus.k_stream(self.room), count=1)
        return last[0][0] if last else "0-0"

    def posted_since(self, head):
        entries = self.r.xrange(bus.k_stream(self.room), f"({head}", "+")
        return any(fields.get("from") == self.agent for _, fields in entries)

    def session_after_first_wake(self):
        return self.session() or getattr(self, "_new_sid", "")

    def replies_on_stdout(self):
        return self.seat["kind"] == "agy" or os.environ.get("SWARM_SEAT_REPLY") == "stdout"

    def report_crash(self, result):
        tail = (result.stderr or result.stdout or "").strip()[-800:]
        self.post(self.coordinator, f"{self.agent}: seat `{self.harness}` exited {result.returncode}.\n{tail}",
                  kind="system")
        self.set_state("waiting", doing=f"crashed (exit {result.returncode})")

    def render(self, msgs):
        lines = [f"New posts for you on the swarm board (room {self.room}), oldest first:", ""]
        for m in msgs:
            topic = f" [{m['topic']}]" if m["topic"] else ""
            lines += [f"--- {m['id']} from {m['from']} to {m['to']}{topic}", m["body"], ""]
        lines.append(f"Reply on the board: bus --room {self.room} send --from {self.agent} --to <who> -")
        return "\n".join(lines)

    def system_prompt(self):
        try:
            text = open(PROMPT_PATH).read()
        except FileNotFoundError:
            return ""
        return (text.replace("{AGENT}", self.agent).replace("{ROOM}", self.room)
                .replace("{COORDINATOR}", self.coordinator))

    # ---- main loop ------------------------------------------------------------
    def run(self):
        self.lock()
        try:
            return self.loop()
        finally:
            self.unlock()

    def loop(self):
        self.set_state("waiting")
        while not self.should_stop():
            msgs, cursor = self.wait()
            finished = [m for m in msgs if self.ends_swarm(m)]
            if finished:
                self.commit(cursor)
                self.set_state("retired", doing=(finished[-1]["body"].strip().splitlines() or [""])[0][:200])
                return 0
            if msgs:
                self.wake_safely(msgs)
                self.commit(cursor)
        return 0

    def ends_swarm(self, msg):
        return bus.ends_swarm(msg, self.r.hget(bus.k_member(self.room, msg["from"]), "role"))

    def wake_safely(self, msgs):
        try:
            self.wake(msgs)
        except Exception as e:  # a worker that dies here leaves the member stuck at `working` with its posts consumed
            self.report_crash(failed([], 1, f"swarm-worker error: {type(e).__name__}: {e}"))


# ---- seats: (worker, prompt, session id) -> (argv, stdin, env) -----------------
def base_env(w, sid):
    path = os.pathsep.join([os.path.dirname(BUS_PATH), os.path.dirname(sys.executable), os.environ.get("PATH", "")])
    return dict(os.environ, SWARM_AGENT=w.agent, SWARM_SESSION=sid, BUS_ROOM=w.room, PATH=path,
                CLAUDECODE="", CLAUDE_CODE_ENTRYPOINT="")


def claude_seat(w, prompt, sid):
    flags = shlex.split(os.environ["SWARM_CLAUDE_FLAGS"]) if "SWARM_CLAUDE_FLAGS" in os.environ else w.claude_flags
    if sid:
        session = ["--resume", sid]
    else:
        w._new_sid = new_uuid()
        session = ["--session-id", w._new_sid, "--append-system-prompt", w.system_prompt()]
    model = ["--model", w.model] if w.model else []
    argv = list(w.seat.get("launcher") or ["claude"]) + ["-p", "--output-format", "json", *session, *model, *flags]
    return argv, prompt, base_env(w, sid)


def codex_seat(w, prompt, sid):
    if sid:
        return ["codex", "exec", "resume", sid, "--json", "-"], prompt, base_env(w, sid)
    model = ["-m", w.model] if w.model else []
    effort = ["-c", f"model_reasoning_effort={w.effort}"] if w.effort else []
    argv = ["codex", "exec", "--json", "-s", "workspace-write", "--skip-git-repo-check", *model, *effort, "-"]
    return argv, w.system_prompt() + "\n\n" + prompt, base_env(w, sid)


def omp_seat(w, prompt, sid):
    session_dir = w.path("omp")
    if sid:
        return ["omp", "-p", "--mode", "json", "--session-dir", session_dir, "-c", prompt], None, base_env(w, sid)
    w._new_sid = session_dir
    model = ["--model", w.model] if w.model else []
    argv = ["omp", "-p", "--mode", "json", "--session-dir", session_dir, *model, w.system_prompt() + "\n\n" + prompt]
    return argv, None, base_env(w, sid)


AGY_NOTE = ("You cannot run tools or read files in this seat: do not call any tool. Everything you can see is in "
            "this prompt, including the workspace snapshot at the end. Your whole reply is posted to the board for you.")
SNAPSHOT_LIMIT = 60_000


def agy_seat(w, prompt, sid):
    cmd = list(w.seat.get("command") or ["agy-review.sh"])
    model = ["-m", w.model] if w.model else []
    text = "\n\n".join([w.system_prompt(), AGY_NOTE, prompt, workspace_snapshot(w.workspace)])
    return cmd + model, text, base_env(w, sid)


BASE_CANDIDATES = ("@{upstream}", "origin/HEAD", "origin/main", "origin/master", "main", "master")


def git(workspace, *args):
    try:
        res = subprocess.run(["git", "-C", workspace, *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return res.stdout if res.returncode == 0 else None


def snapshot_base(workspace):
    """The commit the member's work starts from: SWARM_BASE, else the merge-base with the first ref that resolves.
    None when HEAD is the base itself (work committed straight onto it), so the caller shows HEAD's own commit."""
    head = (git(workspace, "rev-parse", "HEAD") or "").strip()
    for ref in filter(None, (os.environ.get("SWARM_BASE"),) + BASE_CANDIDATES):
        base = (git(workspace, "merge-base", "HEAD", ref) or "").strip()
        if base and base != head:
            return base
    return None


def committed_work(workspace):
    base = snapshot_base(workspace)
    if base:
        return f"----- commits since {base[:12]} -----\n" + (git(workspace, "log", "-p", "--reverse", f"{base}..HEAD") or "")
    shown = git(workspace, "show", "HEAD")
    return f"----- last commit -----\n{shown}" if shown else ""


def workspace_snapshot(workspace):
    """What a tool-less reviewer needs: committed work since the base, uncommitted changes, and new files.
    Capped at SNAPSHOT_LIMIT, and says so when it is cut."""
    if not workspace or not os.path.isdir(workspace):
        return ""
    parts = [f"===== workspace {workspace} =====", committed_work(workspace)]
    diff = git(workspace, "diff", "HEAD")
    if diff:
        parts.append("----- uncommitted (git diff HEAD) -----\n" + diff)
    listed = git(workspace, "ls-files", "--others", "--exclude-standard")
    for name in (listed.split() if listed is not None else sorted(os.listdir(workspace))):
        parts.append(file_block(workspace, name))
    return truncate("\n".join(p for p in parts if p))


def truncate(text):
    if len(text) <= SNAPSHOT_LIMIT:
        return text
    cut = len(text) - SNAPSHOT_LIMIT
    return text[:SNAPSHOT_LIMIT] + f"\n===== snapshot truncated: {cut} more characters not shown =====\n"


def file_block(workspace, name):
    path = os.path.join(workspace, name)
    try:
        with open(path, errors="replace") as f:
            return f"----- {name} -----\n{f.read()}"
    except (IsADirectoryError, FileNotFoundError, PermissionError):
        return ""


def cmd_seat(w, prompt, sid):
    cmd = w.seat.get("command") or shlex.split(os.environ["SWARM_SEAT_CMD"])
    return list(cmd), prompt, base_env(w, sid)


SEATS = {"claude": claude_seat, "codex": codex_seat, "omp": omp_seat, "agy": agy_seat, "cmd": cmd_seat}


# ---- output parsing --------------------------------------------------------------
def json_objects(text):
    for line in (text or "").splitlines():
        line = line.strip()
        if line.startswith("{"):
            try:
                yield json.loads(line)
            except ValueError:
                continue


def usage_tokens(usage):
    tokens_in = sum(usage.get(k) or 0 for k in
                    ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
    return tokens_in, usage.get("output_tokens") or 0


def final_text(obj):
    """The seat's closing answer: claude's `result`, or codex's last agent_message."""
    if obj.get("type") == "result" and isinstance(obj.get("result"), str):
        return obj["result"]
    item = obj.get("item") or {}
    if obj.get("type") == "item.completed" and item.get("type") == "agent_message":
        return item.get("text") or ""
    return ""


def parse_output(text):
    out = {"session": "", "in": 0, "out": 0, "cost": None, "text": ""}
    for obj in json_objects(text):
        out["session"] = obj.get("session_id") or obj.get("thread_id") or out["session"]
        out["text"] = final_text(obj) or out["text"]
        if isinstance(obj.get("usage"), dict):
            tokens_in, tokens_out = usage_tokens(obj["usage"])
            out["in"] += tokens_in
            out["out"] += tokens_out
        if obj.get("total_cost_usd") is not None:
            out["cost"] = (out["cost"] or 0) + float(obj["total_cost_usd"])
    return out


def failed(argv, code, message):
    return subprocess.CompletedProcess(argv, code, stdout="", stderr=message)


def resume_failed(stderr):
    text = (stderr or "").lower()
    return any(s in text for s in RESUME_FAILED)


def senders(msgs):
    return ",".join(dict.fromkeys(m["from"] for m in msgs))


def new_uuid():
    import uuid
    return str(uuid.uuid4())


def main():
    cfg = swarm_config.load()
    p = argparse.ArgumentParser(prog="swarm-worker")
    p.add_argument("agent", type=bus.ident)
    p.add_argument("harness", choices=sorted(cfg["seats"]), help="a seat name from the swarm config")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--workspace")
    return Worker(p.parse_args(), cfg).run()


if __name__ == "__main__":
    sys.exit(main())
